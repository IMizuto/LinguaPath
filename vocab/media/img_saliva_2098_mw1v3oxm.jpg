<script>
window.Dac = window.Dac || {};
(function () {
    if (navigator) {
        window.Dac.clientData = {
            language: navigator.language,
            userAgent: navigator.userAgent,
            innerWidth: window.innerWidth,
            innerHeight: window.innerHeight,
            deviceByMediaQuery: getDeviceByMediaQuery(),
            labDevice: 'desktop', // Device from labrador
            device: 'desktop', // Device from varnish
            paywall: {
                isAuthenticated: isPaywallAuthenticated(),
                toggleAuthenticatedContent: toggleAuthenticatedContent
            }
        };
        function getDeviceByMediaQuery() {
            if (window.matchMedia('(max-width: 767px)').matches) return 'mobile';
            if (window.matchMedia('(max-width: 1023px)').matches) return 'tablet';
            return 'desktop';
        }

        function isPaywallAuthenticated() {
            if (window.Dac && window.Dac.JWTCookie) {
                var JWTCookie = new Dac.JWTCookie({ debug: false });
                return JWTCookie.isAuthenticated();
            }
            return false;
        }

        function toggleAuthenticatedContent() {
            var isPaywallAuthenticatedClass = window.Dac.clientData.paywall.isAuthenticated ? 'dac-paywall-authenticated' : 'dac-paywall-not-authenticated';
            var paywallAuthenticatedItemsToShow = document.querySelectorAll('.' + isPaywallAuthenticatedClass);
            for(var i = 0; i < paywallAuthenticatedItemsToShow.length; i++) {
                paywallAuthenticatedItemsToShow[i].classList.remove(isPaywallAuthenticatedClass);
            }
        }
    }
}());
